# ═══════════════════════════════════════════════════════════════
# CharityChain — Environment Variables Example
# Copy this file to the relevant location and fill in real values.
# NEVER commit real .env files to Git.
# ═══════════════════════════════════════════════════════════════

# ── BLOCKCHAIN ─────────────────────────────────────────────────
# For LOCAL development (Hardhat node):
#   SEPOLIA_RPC_URL is not needed
#   DEPLOYER_PRIVATE_KEY is not needed
#
# For SEPOLIA deployment:
#   Get a free RPC URL from Alchemy (https://alchemy.com)
#   or Infura (https://infura.io)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# Private key of the deployer wallet (Metamask account)
# This wallet needs Sepolia test ETH from https://sepoliafaucet.com
# FORMAT: 0x followed by 64 hex characters
# WARNING: Never commit a real private key to Git
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── DATABASE ───────────────────────────────────────────────────
# LOCAL:      mongodb://localhost:27017/charitychain
# PRODUCTION: Get from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb://localhost:27017/charitychain

# ── BACKEND ────────────────────────────────────────────────────
# Generate a strong random string for JWT signing
# Example command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Port — Render sets this automatically; keep fallback for local
PORT=5000

# The deployed smart contract address (update after each deployment)
# LOCAL:      Address printed by: hardhat run scripts/deploy.js --network localhost
# PRODUCTION: Address printed by: hardhat run scripts/deploy.js --network sepolia
CONTRACT_ADDRESS=0x_YOUR_DEPLOYED_CONTRACT_ADDRESS

# CORS — the URL of the frontend (used to allow cross-origin requests)
# LOCAL:      http://localhost:5173
# PRODUCTION: https://your-frontend-name.onrender.com
FRONTEND_URL=http://localhost:5173

# Admin seed credentials (used by node utils/seed.js)
ADMIN_EMAIL=admin@charitychain.com
ADMIN_PASSWORD=ChangeThisInProduction@1234

# Environment mode
NODE_ENV=development

# ── FRONTEND (Vite — VITE_ prefix required) ────────────────────
# IMPORTANT: VITE_ variables are embedded into the JS bundle at build
# time. NEVER put secrets (JWT_SECRET, DB password, private keys)
# into VITE_ variables.

# Backend API base URL
# LOCAL:      http://localhost:5000/api
# PRODUCTION: https://your-backend-name.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Deployed contract address (same value as CONTRACT_ADDRESS above)
VITE_CONTRACT_ADDRESS=0x_YOUR_DEPLOYED_CONTRACT_ADDRESS

# Chain ID
# LOCAL:      31337
# PRODUCTION: 11155111  (Sepolia)
VITE_NETWORK_CHAIN_ID=31337

# Network display name shown in the UI
# LOCAL:      Hardhat Local
# PRODUCTION: Sepolia Testnet
VITE_NETWORK_NAME=Hardhat Local
