# ─── Backend ───────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/charitychain
JWT_SECRET=your_jwt_secret_here_change_in_production
PORT=5000

# ─── Blockchain ────────────────────────────────────────────
# For local Hardhat node
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# For Sepolia testnet (optional)
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# DEPLOYER_PRIVATE_KEY=0xYourPrivateKeyHere  ← NEVER commit this

# ─── Frontend (Vite env vars must start with VITE_) ────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere
VITE_NETWORK_CHAIN_ID=31337
# 31337 = Hardhat local | 11155111 = Sepolia
VITE_EXPLORER_BASE_URL=http://localhost:8545
# For Sepolia: https://sepolia.etherscan.io
